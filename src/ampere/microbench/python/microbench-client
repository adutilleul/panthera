# Wrapper for the installed microbenchmark gRPC client.
set -euo pipefail

prefix="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_base="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}"
export PANTHERA_GEN_DIR="${PANTHERA_GEN_DIR:-${cache_base}/panthera-microbench/gen}"

exec "${PYTHON:-python3}" \
    "${prefix}/lib/python/panthera/microbench/python/microbench_client.py" "$@"
